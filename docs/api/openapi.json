          "error": {
            "type": "string",
            "description": "Texto humano, hoje em frances. Pode mudar sem aviso."
          },
          "field": {
            "type": "string",
            "description": "Presente em VALIDATION_ERROR: campo que falhou."
          },
          "rule": {
            "type": "string",
