  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Estado do servico",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/otp": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Pede o codigo OTP de login",
        "description": "Ao contrario do `/api/v1/auth/token`, responde `ok` sem revelar se a conta existe. Se o cooldown de 60s por e-mail estiver ativo, devolve `429` com `code=RESEND_COOLDOWN` — o app deve mostrar contagem regressiva (o envio nao aconteceu).",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "maxLength": 320,
                    "format": "email"
                  }
                },
                "required": [
                  "email"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Codigo solicitado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ok"
                }
              }
            }
          },
          "400": {
            "description": "Corpo invalido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "Cooldown de reenvio (RESEND_COOLDOWN) ou tentativas em excesso (RATE_LIMITED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/token": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Troca o codigo OTP por um par de tokens do dispositivo",
        "description": "Reusa o mesmo OTP do web (mesmo rate limit e mesmo contador de tentativas). O access vai no header Authorization das demais chamadas.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "maxLength": 320,
                    "format": "email"
                  },
                  "otp": {
                    "type": "string",
                    "minLength": 4,
                    "maxLength": 10
                  },
                  "deviceName": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "platform": {
                    "type": "string",
                    "maxLength": 40
                  }
                },
                "required": [
                  "email",
                  "otp"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Par de tokens emitido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenPair"
                }
              }
            }
          },
          "400": {
            "description": "Codigo invalido (code=INVALID_CODE) ou corpo invalido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "Tentativas em excesso (code=RATE_LIMITED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/token/refresh": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Renova o par de tokens",
        "description": "O refresh e single-use (rotacao). Reapresentar um refresh consumido dentro da janela de graca e tratado como retry e devolve par novo; fora da janela e reuso, e a familia inteira e revogada.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "refreshToken": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "refreshToken"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Par novo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenPair"
                }
              }
            }
          },
          "401": {
            "description": "Refresh invalido, expirado ou reutilizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/token/revoke": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Revoga o token apresentado (logout do dispositivo)",
        "description": "Aceita o access no header Authorization ou o refresh no corpo — assim o app consegue sair mesmo com o access expirado.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "refreshToken": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "refreshToken"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token revogado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ok"
                }
              }
            }
          },
          "401": {
            "description": "Nenhum token apresentado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/expenses": {
      "get": {
        "tags": [
          "expenses"
        ],
        "summary": "Lista despesas com resumo e graficos do periodo",
        "description": "Sem parametro de periodo devolve lista + totais (sem graficos). Com escopo (scope/anchor, month, ou from/to) devolve tambem os graficos.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "month | year | all"
            },
            "required": false,
            "name": "scope",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "YYYY-MM ou YYYY"
            },
            "required": false,
            "name": "anchor",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "YYYY-MM (forma antiga)"
            },
            "required": false,
            "name": "month",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "YYYY-MM-DD"
            },
            "required": false,
            "name": "from",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "YYYY-MM-DD"
            },
            "required": false,
            "name": "to",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "category_id",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Default 50, maximo 1000"
            },
            "required": false,
            "name": "limit",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista, resumo e graficos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExpenseList"
                }
              }
            }
          },
          "401": {
            "description": "Nao autenticado (code=UNAUTHENTICATED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "expenses"
        ],
        "summary": "Cria uma despesa",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "Chave unica por operacao (um UUID serve). Repetir o POST com a MESMA chave e o MESMO corpo devolve a resposta ORIGINAL — mesmo `id`, sem criar de novo. Use em retry de rede movel. Mesma chave com corpo diferente devolve 409."
            },
            "required": false,
            "description": "Chave unica por operacao (um UUID serve). Repetir o POST com a MESMA chave e o MESMO corpo devolve a resposta ORIGINAL — mesmo `id`, sem criar de novo. Use em retry de rede movel. Mesma chave com corpo diferente devolve 409.",
            "name": "Idempotency-Key",
            "in": "header"
          }
        ],
        "requestBody": {
          "description": "O campo `amount` vai em UNIDADES (ex.: 12.5 = CHF 12.50); o backend converte para centavos. As RESPOSTAS devolvem centavos, como inteiro.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "amount": {
                    "type": "number",
                    "minimum": 0,
                    "exclusiveMinimum": true
                  },
                  "currency": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 3,
                    "default": "CHF"
                  },
                  "expenseDate": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "paymentMethod": {
                    "type": "string",
                    "nullable": true,
                    "enum": [
                      "card",
                      "cash",
                      "invoice",
                      "twint",
                      "transfer",
                      "other",
                      "pix",
                      "boleto"
                    ]
                  },
                  "categoryId": {
                    "type": "string",
                    "nullable": true,
                    "minLength": 1
                  },
                  "isRecurring": {
                    "type": "boolean"
                  },
                  "recurringDayOfMonth": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 31
                  }
                },
                "required": [
                  "description",
                  "amount",
                  "expenseDate"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Despesa criada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateExpenseResponse"
                }
              }
            }
          },
          "400": {
            "description": "Corpo invalido (code=VALIDATION_ERROR) ou Idempotency-Key malformada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Nao autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Chave ja usada com corpo diferente (code=IDEMPOTENCY_KEY_REUSED) ou requisicao em andamento (code=IDEMPOTENCY_IN_PROGRESS)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
