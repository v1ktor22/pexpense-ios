{
  "openapi": "3.0.0",
  "info": {
    "title": "Pexpense API",
    "version": "1.0.0",
    "description": "API do Pexpense para clientes nativos. Erros seguem { code, error }: `code` e estavel e nunca localizado; `error` e texto humano."
  },
  "servers": [
    {
      "url": "https://app.pexpense.ch"
    },
    {
      "url": "http://devpexpense.local"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token de dispositivo (access). Obtido em POST /api/v1/auth/token e renovado em POST /api/v1/auth/token/refresh."
      }
    },
